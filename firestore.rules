rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Stricter check for RBAC config collections: caller must be signed in AND
    // have role == 'admin' on their own users/ doc (not just "any signed-in user").
    function isSuperAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }

    // Public content: readable by anyone, editable only by a signed-in admin.
    match /advantages/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /leaders/{docId}    { allow read: if true; allow write: if isAdmin(); }
    match /news/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /news_categories/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /clients/{docId}    { allow read: if true; allow write: if isAdmin(); }
    match /badges/{docId}     { allow read: if true; allow write: if isAdmin(); }
    match /services/{docId}   { allow read: if true; allow write: if isAdmin(); }
    match /keyPartners/{docId}{ allow read: if true; allow write: if isAdmin(); }
    match /portfolio/{docId}  { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{docId}    { allow read: if true; allow write: if isAdmin(); }
    match /site_content/{docId} { allow read: if true; allow write: if isAdmin(); }

    // RBAC: admin-panel module/menu structure & per-role permission matrix. Readable
    // by any signed-in user (each user needs to read their own role's permissions and
    // the nav structure), writable only by role == 'admin'.
    match /modules/{docId}         { allow read: if request.auth != null; allow write: if isSuperAdmin(); }
    // menu_items also drives public portal visibility (navbar links, homepage sections via
    // showOnPortal), so it must be readable by anyone, not just signed-in admin users.
    match /menu_items/{docId}      { allow read: if true; allow write: if isSuperAdmin(); }
    match /role_permissions/{docId}{ allow read: if request.auth != null; allow write: if isSuperAdmin(); }

    // Contact form: anyone can submit a lead, only a signed-in admin can read/manage them.
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Page view analytics: anyone can log a view, only a signed-in admin can read them.
    match /pageViews/{viewId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin profiles: no public access at all. No password field is stored here anymore
    // (credentials live in Firebase Authentication) but names/roles/avatars still shouldn't leak.
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // Push notification device tokens: a user may only read/write their own
    // token doc. Sends happen server-side via Admin SDK (bypasses these rules).
    match /fcm_tokens/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }

    // Cron execution history (written server-side only, via Admin SDK using
    // CRON_SECRET — bypasses these rules entirely). Signed-in admin-panel users
    // can read it to see what ran and what changed; no client can write to it.
    match /cron_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Internal team chat (group room + 1-on-1 DMs): only signed-in admin-panel
    // users can read/write, same trust boundary as the users/ collection above.
    match /chatConversations/{convoId} {
      allow read, write: if isAdmin();
      match /messages/{messageId} {
        allow read, write: if isAdmin();
      }
    }

    // Public visitor live chat (portal widget): anyone can create/read a thread and
    // bump its meta (bot replies are written client-side from the visitor's own
    // browser — no server involved), same trust boundary as leads/ above since the
    // conversation id is an unguessable client-generated UUID. Only an admin may
    // delete a thread; message edits/deletes are also admin-only.
    match /visitorChats/{convoId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
