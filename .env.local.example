NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Domain produksi (dipakai untuk sitemap.xml, canonical URL, dan Open Graph)
NEXT_PUBLIC_SITE_URL=https://amk-portal.vercel.app

# Firebase Admin SDK (server-only, JANGAN pakai prefix NEXT_PUBLIC_).
# Diambil dari Service Account Key: Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Dipakai oleh app/api/admin/users untuk membuat/menghapus akun admin dari dalam admin panel.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
